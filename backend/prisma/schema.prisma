generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  ADMINISTRADOR
  OPERADOR
  AVALIADOR
}

model OM {
  id          Int          @id @default(autoincrement())
  sigla       String
  createdAt   DateTime     @default(now())
  codom       String       @unique
  usuarios    Usuario[]
  militares   Militar[]
  subunidades Subunidade[]
}

model Subunidade {
  id        Int      @id @default(autoincrement())
  nome      String
  omId      Int
  createdAt DateTime @default(now())

  militares Militar[]
  om        OM        @relation(fields: [omId], references: [id])

  @@unique([nome, omId])
}

model PostoGraduacao {
  id         Int    @id @default(autoincrement())
  nome       String
  abreviacao String @unique
  ordem      Int    @unique

  militares Militar[]
}

model Curso {
  id     Int    @id @default(autoincrement())
  nome   String
  codigo String @unique

  militares Militar[]
}

model Militar {
  id               Int      @id @default(autoincrement())
  nomeCompleto     String
  nomeGuerra       String
  segmento         String
  dataNascimento   DateTime
  omId             Int
  subunidadeId     Int
  postoGraduacaoId Int
  cursoId          Int
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())

  avaliacoes     AvaliacaoTAF[]
  curso          Curso          @relation(fields: [cursoId], references: [id])
  om             OM             @relation(fields: [omId], references: [id])
  postoGraduacao PostoGraduacao @relation(fields: [postoGraduacaoId], references: [id])
  subunidade     Subunidade     @relation(fields: [subunidadeId], references: [id])
}

model CampanhaTAF {
  id        Int      @id @default(autoincrement())
  ano       Int
  numeroTAF Int
  createdAt DateTime @default(now())

  chamadas ChamadaTAF[]

  @@unique([ano, numeroTAF])
}

model ChamadaTAF {
  id            Int       @id @default(autoincrement())
  numeroChamada Int
  campanhaId    Int
  createdAt     DateTime  @default(now())
  periodoInicio DateTime?
  periodoFim    DateTime?

  codigoCertificacaoHash String?
  codigoGeradoEm         DateTime?

  avaliadorId Int?
  avaliador   Usuario? @relation("AvaliadorChamada", fields: [avaliadorId], references: [id])

  campanha   CampanhaTAF    @relation(fields: [campanhaId], references: [id])
  avaliacoes AvaliacaoTAF[]

  @@unique([campanhaId, numeroChamada])
}

model AvaliacaoTAF {
  id        Int @id @default(autoincrement())
  militarId Int
  chamadaId Int

  corrida       Float?
  mencaoCorrida String @default("NR")

  flexao       Int?
  mencaoFlexao String @default("NR")

  abdominal       Int?
  mencaoAbdominal String @default("NR")

  barra       Int?
  mencaoBarra String @default("NR")

  ppm       String?
  mencaoPPM String  @default("NR")

  mencaoFinal String @default("NR")
  situacao    String @default("PENDENTE")

  createdAt DateTime @default(now())

  militar Militar    @relation(fields: [militarId], references: [id])
  chamada ChamadaTAF @relation(fields: [chamadaId], references: [id])

  @@unique([militarId, chamadaId])
}

model IndiceTAF {
  id          Int      @id @default(autoincrement())
  segmento    String
  cursoCodigo String
  exercicio   String
  idadeMin    Int
  idadeMax    Int
  mencao      String
  valorMin    Float?
  valorMax    Float?
  createdAt   DateTime @default(now())
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String

  perfil PerfilUsuario @default(OPERADOR)

  omId Int
  om   OM  @relation(fields: [omId], references: [id])

  createdAt DateTime @default(now())

  chamadasGeradas ChamadaTAF[] @relation("AvaliadorChamada")
}
