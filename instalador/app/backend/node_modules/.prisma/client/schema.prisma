generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OM {
  id          Int          @id @default(autoincrement())
  sigla       String
  createdAt   DateTime     @default(now())
  codom       String       @unique
  cidade      String?
  uf          String?
  militares   Militar[]
  subunidades Subunidade[]
  usuarios    Usuario[]
}

model Subunidade {
  id        Int       @id @default(autoincrement())
  nome      String
  omId      Int
  createdAt DateTime  @default(now())
  militares Militar[]
  om        OM        @relation(fields: [omId], references: [id])

  @@unique([nome, omId])
}

model PostoGraduacao {
  id         Int       @id @default(autoincrement())
  nome       String
  abreviacao String    @unique
  ordem      Int       @unique
  militares  Militar[]
}

model Curso {
  id        Int       @id @default(autoincrement())
  nome      String
  codigo    String    @unique
  militares Militar[]
}

model Militar {
  id                   Int                    @id @default(autoincrement())
  nomeCompleto         String
  nomeGuerra           String
  segmento             String
  dataNascimento       DateTime
  omId                 Int
  subunidadeId         Int
  postoGraduacaoId     Int
  cursoId              Int
  tafAlternativo       Boolean                @default(false)
  boletimInternoNumero String?
  boletimInternoData   DateTime?
  ativo                Boolean                @default(true)
  createdAt            DateTime               @default(now())
  avaliacoes           AvaliacaoTAF[]
  exclusoesAvaliacao   LogExclusaoAvaliacao[]
  curso                Curso                  @relation(fields: [cursoId], references: [id])
  om                   OM                     @relation(fields: [omId], references: [id])
  postoGraduacao       PostoGraduacao         @relation(fields: [postoGraduacaoId], references: [id])
  subunidade           Subunidade             @relation(fields: [subunidadeId], references: [id])
}

model CampanhaTAF {
  id        Int          @id @default(autoincrement())
  ano       Int
  numeroTAF Int
  createdAt DateTime     @default(now())
  chamadas  ChamadaTAF[]

  @@unique([ano, numeroTAF])
}

model ChamadaTAF {
  id                     Int                    @id @default(autoincrement())
  numeroChamada          Int
  campanhaId             Int
  createdAt              DateTime               @default(now())
  periodoFim             DateTime?
  periodoInicio          DateTime?
  avaliadorId            Int?
  codigoGeradoEm         DateTime?
  codigoAutenticacaoHash String?
  avaliacoes             AvaliacaoTAF[]
  exclusoesAvaliacao     LogExclusaoAvaliacao[]
  avaliador              Usuario?               @relation("AvaliadorChamada", fields: [avaliadorId], references: [id])
  campanha               CampanhaTAF            @relation(fields: [campanhaId], references: [id])

  @@unique([campanhaId, numeroChamada])
}

model AvaliacaoTAF {
  id              Int            @id @default(autoincrement())
  militarId       Int
  chamadaId       Int
  corrida         Float?
  mencaoCorrida   String         @default("NR")
  flexao          Int?
  mencaoFlexao    String         @default("NR")
  abdominal       Int?
  mencaoAbdominal String         @default("NR")
  barra           Int?
  mencaoBarra     String         @default("NR")
  ppm             String?
  mencaoPPM       String         @default("NR")
  mencaoFinal     String         @default("NR")
  suficiencia     String         @default("S")
  situacao        String         @default("PENDENTE")
  createdAt       DateTime       @default(now())
  chamada         ChamadaTAF     @relation(fields: [chamadaId], references: [id])
  militar         Militar        @relation(fields: [militarId], references: [id])
  logs            LogAvaliacao[]

  @@unique([militarId, chamadaId])
}

model IndiceTAF {
  id          Int      @id @default(autoincrement())
  segmento    String
  cursoCodigo String
  exercicio   String
  idadeMin    Int
  idadeMax    Int
  mencao      String
  valorMin    Float?
  valorMax    Float?
  createdAt   DateTime @default(now())
}

model Usuario {
  id               Int               @id @default(autoincrement())
  nome             String
  email            String            @unique
  senha            String
  perfil           PerfilUsuario?
  omId             Int
  createdAt        DateTime          @default(now())
  subunidade       String?
  status           StatusUsuario     @default(PENDENTE)
  chamadasGeradas  ChamadaTAF[]      @relation("AvaliadorChamada")
  historicoColetas HistoricoColeta[]
  logs             LogAvaliacao[]
  om               OM                @relation(fields: [omId], references: [id])
}

model LogAvaliacao {
  id          Int              @id @default(autoincrement())
  avaliacaoId Int
  usuarioId   Int
  acao        AcaoLogAvaliacao
  origem      OrigemLog        @default(WEB)
  createdAt   DateTime         @default(now())
  avaliacao   AvaliacaoTAF     @relation(fields: [avaliacaoId], references: [id])
  usuario     Usuario          @relation(fields: [usuarioId], references: [id])
}

model HistoricoColeta {
  id         Int                 @id @default(autoincrement())
  usuarioId  Int
  tipo       TipoHistoricoColeta
  arquivo    String
  quantidade Int?
  origem     OrigemLog           @default(WEB)
  createdAt  DateTime            @default(now())
  usuario    Usuario             @relation(fields: [usuarioId], references: [id])
}

model SolicitacaoAcesso {
  id        Int                     @id @default(autoincrement())
  email     String
  tipo      TipoSolicitacaoAcesso
  status    StatusSolicitacaoAcesso @default(PENDENTE)
  token     String?                 @unique
  expiraEm  DateTime?
  createdAt DateTime                @default(now())
}

enum PerfilUsuario {
  ADMINISTRADOR
  CADASTRADOR
  AVALIADOR
  GERAL
}

enum StatusUsuario {
  PENDENTE
  ATIVO
  BLOQUEADO
}

enum TipoSolicitacaoAcesso {
  NOVA_SENHA
  ATIVACAO_PERFIL
}

enum StatusSolicitacaoAcesso {
  PENDENTE
  ATENDIDA
  CANCELADA
}

enum AcaoLogAvaliacao {
  CADASTRO
  ATUALIZACAO
}

enum OrigemLog {
  WEB
  CAMPO
  IMPORTACAO
}

enum TipoHistoricoColeta {
  IMPORTACAO
  EXPORTACAO
}

model LogExclusaoAvaliacao {
  id Int @id @default(autoincrement())

  avaliacaoId Int
  militarId   Int
  chamadaId   Int

  dataHora DateTime @default(now())

  origem OrigemLog
  acao   String

  militar Militar    @relation(fields: [militarId], references: [id])
  chamada ChamadaTAF @relation(fields: [chamadaId], references: [id])
}
